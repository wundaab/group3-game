  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 126
  indentLevel: 0
  storyText: That's smart - no need to overdo it. Oh, and since you have pills left
    over, can I have some? This cough of mine won't go away.
  description: 
  character: {fileID: 278856409}
