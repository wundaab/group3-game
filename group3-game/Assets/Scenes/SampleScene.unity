  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1839127032}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 43
  indentLevel: 0
  storyText: If you stop early, some bacteria will survive and can become resistant
    to the antibiotic.
  description: 
  character: {fileID: 1125103575}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 1302764264}
